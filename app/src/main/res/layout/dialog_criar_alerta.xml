<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_alert_sheet" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/alert_sheet_title" android:textSize="24sp" android:textStyle="bold"
                android:textColor="#171717" android:accessibilityHeading="true" />
            <ImageButton android:id="@+id/cancel_alert" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" app:tint="#171717"
                android:contentDescription="@string/close" />
        </LinearLayout>
        <GridLayout android:id="@+id/grelha_categorias" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:columnCount="3" android:rowCount="2" android:alignmentMode="alignMargins">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/category_works" style="@style/Widget.RoadGuard.AlertChoice"
                android:layout_columnWeight="1" android:layout_margin="4dp" android:layout_gravity="fill"
                android:text="@string/alert_works" app:icon="@drawable/ic_alert_works" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/category_road_closed" style="@style/Widget.RoadGuard.AlertChoice"
                android:layout_columnWeight="1" android:layout_margin="4dp" android:layout_gravity="fill"
                android:text="@string/alert_road_closed" app:icon="@drawable/ic_alert_road_closed" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/category_police" style="@style/Widget.RoadGuard.AlertChoice"
                android:layout_columnWeight="1" android:layout_margin="4dp" android:layout_gravity="fill"
                android:text="@string/alert_police" app:icon="@drawable/ic_alert_police" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/category_accident" style="@style/Widget.RoadGuard.AlertChoice"
                android:layout_columnWeight="1" android:layout_margin="4dp" android:layout_gravity="fill"
                android:text="@string/alert_accident" app:icon="@drawable/ic_alert_accident" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/category_pothole" style="@style/Widget.RoadGuard.AlertChoice"
                android:layout_columnWeight="1" android:layout_margin="4dp" android:layout_gravity="fill"
                android:text="@string/alert_pothole" app:icon="@drawable/ic_alert_pothole" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/category_traffic" style="@style/Widget.RoadGuard.AlertChoice"
                android:layout_columnWeight="1" android:layout_margin="4dp" android:layout_gravity="fill"
                android:text="@string/alert_traffic" app:icon="@drawable/ic_alert_traffic" />
        </GridLayout>
        <TextView android:id="@+id/alert_selection_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical"
            android:text="@string/alert_choose_category" android:textSize="14sp" android:textColor="#555555"
            android:accessibilityLiveRegion="polite" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/confirm_alert"
            android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="4dp"
            android:text="@string/alert_save" android:textSize="18sp" android:textAllCaps="false"
            android:enabled="false" android:textColor="@color/alert_submit_text"
            app:backgroundTint="@color/alert_submit_background" app:cornerRadius="8dp" />
    </LinearLayout>
</ScrollView>
