<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/zone_dialog_title"
                android:textColor="#202124"
                android:textSize="22sp"
                android:textStyle="bold" />

        <EditText
                android:id="@+id/zone_search_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_map_search"
                android:hint="@string/zone_place_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:importantForAutofill="no"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#202124"
                android:textColorHint="#70757A" />

        <ListView
                android:id="@+id/zone_search_suggestions"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_map_search"
                android:divider="#E8EAED"
                android:dividerHeight="1dp"
                android:visibility="gone" />

        <EditText
                android:id="@+id/zone_name_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_map_search"
                android:hint="@string/zone_name_hint"
                android:inputType="textCapSentences"
                android:importantForAutofill="no"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="#202124"
                android:textColorHint="#70757A" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/zone_radius_label"
                android:textColor="#5F6368"
                android:textSize="14sp" />

        <Spinner
                android:id="@+id/zone_radius_spinner"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_map_search"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancelar_zona"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/zone_cancel"
                    android:textAllCaps="false"
                    android:textColor="#5F6368" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_guardar_zona"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/zone_save"
                    android:textAllCaps="false"
                    app:backgroundTint="#171717"
                    app:cornerRadius="12dp" />
        </LinearLayout>
</LinearLayout>
