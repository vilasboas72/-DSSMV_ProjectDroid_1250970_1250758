<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <LinearLayout
            android:id="@+id/map_search_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="76dp"
            android:background="@drawable/bg_map_search"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

        <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/search_description"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#5F6368" />

        <EditText
                android:id="@+id/map_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/search_map"
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:textColor="#202124"
                android:textColorHint="#70757A"
                android:textSize="16sp" />
    </LinearLayout>

    <ListView
            android:id="@+id/search_suggestions"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="76dp"
            android:background="@drawable/bg_map_search"
            android:divider="#E8EAED"
            android:dividerHeight="1dp"
            android:elevation="5dp"
            android:visibility="gone" />

    <LinearLayout
            android:id="@+id/route_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_route_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

        <TextView
                android:id="@+id/route_destination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#202124"
                android:textSize="18sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/route_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#5F6368"
                android:textSize="14sp" />

        <TextView
                android:id="@+id/route_guidance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#202124"
                android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_trip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/start_trip"
                android:textAllCaps="false"
                app:backgroundTint="#1A73E8"
                app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_end_trip"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/end_trip"
                android:textAllCaps="false"
                android:textColor="#1A73E8"
                android:visibility="gone"
                app:cornerRadius="14dp"
                app:strokeColor="#DADCE0" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_alert"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:minWidth="160dp"
            android:text="@string/alert_create"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:elevation="8dp"
            app:backgroundTint="#171717"
            app:cornerRadius="8dp" />

    <ImageButton
            android:id="@+id/btn_map_menu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_map_menu"
            android:contentDescription="@string/map_menu_description"
            android:elevation="6dp"
            android:padding="12dp"
            android:src="@drawable/ic_map_menu" />

</FrameLayout>
