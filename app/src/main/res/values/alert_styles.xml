<resources>
    <style name="Widget.RoadGuard.AlertChoice" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">128dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">3</item>
        <item name="iconGravity">textTop</item>
        <item name="iconSize">42dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@null</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/alert_choice_text</item>
        <item name="backgroundTint">@color/alert_choice_background</item>
        <item name="strokeColor">@color/alert_choice_stroke</item>
        <item name="cornerRadius">6dp</item>
    </style>
</resources>
